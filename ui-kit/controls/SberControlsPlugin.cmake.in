@PACKAGE_INIT@
set(BINARIES_INSTALL_DIR "@BINARIES_INSTALL_DIR@")
set(INCLUDES_INSTALL_DIR "@INCLUDES_INSTALL_DIR@")

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core)
find_dependency(Qt6Gui)
find_dependency(Qt6Qml)
find_dependency(Qt6Quick)

add_library(SberControlsPlugin SHARED IMPORTED)
set_target_properties(SberControlsPlugin PROPERTIES
  IMPORTED_LOCATION ${BINARIES_INSTALL_DIR}/Sber/Controls/libSberControlsPlugin.so
  INTERFACE_INCLUDE_DIRECTORIES ${INCLUDES_INSTALL_DIR}
)
message("-- Found Sber.Controls")
