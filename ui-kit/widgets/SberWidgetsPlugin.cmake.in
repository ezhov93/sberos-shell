@PACKAGE_INIT@
set(BINARIES_INSTALL_DIR "${PACKAGE_PREFIX_DIR}/@BINARIES_INSTALL_DIR@")
set(INCLUDES_INSTALL_DIR "${PACKAGE_PREFIX_DIR}/@INCLUDES_INSTALL_DIR@")

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core)
find_dependency(Qt6Gui)
find_dependency(Qt6Qml)
find_dependency(Qt6Quick)

add_library(SberWidgetsPlugin SHARED IMPORTED)
set_target_properties(SberWidgetsPlugin PROPERTIES
  IMPORTED_LOCATION ${BINARIES_INSTALL_DIR}/Sber/Widgets/libSberWidgetsPlugin.so
  INTERFACE_INCLUDE_DIRECTORIES ${INCLUDES_INSTALL_DIR}
)
message("-- Found Sber.Widgets")
